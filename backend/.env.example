# URL de connexion à la base PostgreSQL.
# En local : postgresql://user:password@localhost:5432/communication_app?schema=public
# En production (ex: Neon) : utilisez l'URL fournie par le service, avec ?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/communication_app?schema=public"

# Secret utilisé pour signer les JWT (remplacez par une longue chaîne aléatoire en production)
JWT_SECRET="changez-moi-en-production"

# Durée de validité des tokens (ex: 7d, 12h, 3600)
JWT_EXPIRES_IN="7d"

# Port d'écoute du serveur
PORT=4000

# Origine(s) autorisée(s) pour CORS (séparées par une virgule), "*" pour tout autoriser en dev
CORS_ORIGIN="*"

# --- Paiement (achat de crédits "Solde" avec du vrai argent, voir
# creditPurchase.controller.js) : clé API + Site ID trouvés dans le tableau
# de bord CinetPay (docs.cinetpay.com) une fois le compte marchand créé et
# validé. Sans ces 3 variables, l'achat de crédits renvoie une erreur claire
# au lieu de planter.
CINETPAY_APIKEY=""
CINETPAY_SITE_ID=""
# URL publique de CE serveur (ex: https://seourouapps.onrender.com), utilisée
# pour construire notify_url/return_url envoyées à CinetPay. Doit être une
# URL joignable depuis internet, PAS localhost (CinetPay doit pouvoir
# l'appeler depuis l'extérieur) — donc à renseigner sur Render, pas en local.
PUBLIC_BASE_URL=""