// Schéma de base de données pour l'application de communication
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  password    String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Dernière fois que cet utilisateur avait au moins un appareil/onglet
  // connecté au socket temps réel (mis à jour quand son dernier socket se
  // déconnecte, voir utils/presence.js) — sert à afficher "vu à ..." quand il
  // n'est pas actuellement en ligne, comme WhatsApp. "En ligne" en revanche
  // n'est jamais stocké en base : c'est un état purement en mémoire (voir
  // presence.js), diffusé en direct via Socket.io.
  lastSeenAt  DateTime?
  // Confidentialité "dernière connexion" (Paramètres → Confidentialité), comme
  // WhatsApp : quand activé, "en ligne"/"vu à ..." n'est jamais communiqué aux
  // AUTRES utilisateurs (ni via l'API, ni via les événements temps réel). Ne
  // change rien à ce que l'utilisateur voit lui-même des autres.
  hideLastSeen Boolean @default(false)
  // Numéro confirmé par code OTP envoyé par SMS (voir utils/otp.js, utils/sms.js).
  // Ne bloque rien pour l'instant (l'inscription reste possible sans vérifier) :
  // juste un badge "Numéro vérifié" affiché dans Paramètres, comme un premier pas
  // vers une vérification obligatoire plus tard.
  phoneVerified Boolean @default(false)
  // Administrateur de l'application (pas d'un groupe/communauté en
  // particulier) : peut supprimer le compte de n'importe quel autre
  // utilisateur depuis Paramètres → Administration. Attribué automatiquement
  // au(x) numéro(s) listé(s) dans la variable d'environnement ADMIN_PHONES
  // (voir utils/adminPhones.js) — pas d'interface pour le retirer pour
  // l'instant, volontairement : ce n'est pas demandé et une mauvaise
  // manipulation ici serait plus grave qu'ailleurs.
  isAdmin Boolean @default(false)

  // Contrôle parental (Paramètres → Contrôle parental) : un compte "enfant"
  // peut être supervisé par un compte "parent" via cette relation réflexive.
  // La liaison se fait par un code temporaire à usage unique (voir
  // ParentLinkCode) plutôt qu'un scan QR/NFC. onDelete: SetNull (pas Cascade)
  // sur supervisorId : si le compte parent est supprimé, l'enfant redevient
  // simplement un compte normal non supervisé au lieu d'être supprimé avec lui.
  // Un compte n'a qu'un seul superviseur à la fois, mais peut lui-même
  // superviser plusieurs comptes (plusieurs enfants).
  supervisorId    String?
  supervisor      User?   @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  supervisedUsers User[]  @relation("Supervision")
  // Qui peut m'ajouter à une conversation de groupe (vérifié dans
  // createConversation) : "everyone" (par défaut, comportement inchangé),
  // "contacts" (seulement quelqu'un avec qui j'ai déjà une conversation
  // 1-à-1 existante), ou "noone" (jamais). Modifiable uniquement par le
  // superviseur de ce compte (Contrôle parental) — pas par l'utilisateur
  // lui-même, sans quoi la restriction n'en serait pas vraiment une.
  restrictGroupAdd String @default("everyone")
  parentLinkCodes  ParentLinkCode[]

  participations ConversationParticipant[]
  messages        Message[]
  callParticipations CallParticipant[]
  pushSubscriptions  PushSubscription[]
  // Appareils connectés (Paramètres → Appareils connectés, voir modèle Device
  // ci-dessous) : un par connexion (register/login), utilisé pour lister et
  // déconnecter à distance ce qui est actif, comme WhatsApp.
  devices Device[]
  // Utilisateurs que j'ai bloqués, et utilisateurs qui m'ont bloqué (Paramètres → Confidentialité).
  blockedUsers   BlockedUser[] @relation("BlockerRelation")
  blockedByUsers BlockedUser[] @relation("BlockedRelation")
  // Statuts (onglet "Actus") : ceux que j'ai publiés, et ceux que j'ai vus.
  statuses     Status[]
  statusViews  StatusView[]
  // Communautés (onglet "Communautés") : celles que j'ai créées, et celles
  // auxquelles j'appartiens (en tant que membre ou admin).
  createdCommunities Community[]
  communityMemberships CommunityMember[]
  // Réactions emoji laissées sur des messages (👍 ❤️ 😂 ...), comme WhatsApp.
  messageReactions MessageReaction[]
  // Messages que j'ai choisi de "supprimer pour moi seulement" (menu d'appui
  // long) : masqués uniquement de mon côté, voir Message.hiddenFor.
  hiddenMessages MessageHiddenForUser[]
  // Mon répertoire de contacts (voir modèle Contact ci-dessous) : numéros
  // importés depuis mon téléphone ou ajoutés à la main. Détermine qui
  // apparaît dans "Nouvelle discussion" et dans le sélecteur de membres d'un
  // groupe/communauté — jamais tous les comptes de l'appli, comme WhatsApp.
  contacts Contact[]
  // "Clips" (produit vidéo courte, façon TikTok, lié depuis "Autres produits"
  // dans Paramètres — voir modèle Video ci-dessous) : mêmes comptes que le
  // reste de l'application, pas d'inscription séparée.
  videos       Video[]
  videoLikes   VideoLike[]
  videoSaves   VideoSave[]
  videoComments VideoComment[]
  // Abonnements "Clips" (onglet "Ami(e)s") : comme TikTok, suivre quelqu'un
  // est direct (pas de demande à accepter) — voir modèle Follow ci-dessous.
  following Follow[] @relation("Following")
  followers Follow[] @relation("Followers")
  // Sons de la bibliothèque partagée "Clips" (bouton "Ajouter un son") que
  // j'ai ajoutés — réservé aux administrateurs, voir modèle Sound ci-dessous
  // et middleware/auth.js, requireAdmin.
  addedSounds Sound[]
  // Mes directs "LIVE" (voir modèle LiveSession ci-dessous) — diffusés par
  // moi, pas ceux que j'ai seulement regardés (pas de trace des spectateurs
  // en base, voir sockets/live.js).
  liveSessions LiveSession[]

  // "Solde" (menu ☰ de Diarala_Tiktak) : crédits INTERNES à l'application,
  // pas de l'argent réel — aucun paiement/virement bancaire réel n'est géré
  // ici (ça demanderait un vrai prestataire de paiement, une immatriculation,
  // etc., bien au-delà de ce produit de test). Un crédit s'obtient en étant
  // aimé/suivi (voir video.controller.js/follow.controller.js) et se dépense
  // pour "Promouvoir" une publication (voir Video.boostedUntil ci-dessous).
  // Ce compteur est dénormalisé pour un affichage instantané ; le détail des
  // mouvements vit dans CreditTransaction (voir plus bas), qui reste la
  // source de vérité en cas de doute.
  creditsBalance      Int                 @default(0)
  creditTransactions  CreditTransaction[]
  // Vues de mes vidéos, pour "TikTok Studio" (voir modèle VideoView plus bas).
  videoViews          VideoView[]
  // Signalements que j'ai envoyés (menu d'appui long → "Signaler", voir
  // modèle VideoReport plus bas) — pas ceux reçus sur mes propres vidéos
  // (pas d'écran dédié pour l'instant, juste une modération manuelle possible
  // directement en base).
  videoReports        VideoReport[]
  // "Paramètres et confidentialité" (Diarala_Tiktak) : quand activé, mes
  // publications "Clips" n'apparaissent dans le fil "Pour toi" de personne
  // d'autre que mes abonnés (comme un compte TikTok privé) — voir
  // video.controller.js, listVideos. Ne concerne QUE Clips, pas les statuts
  // ni les messages de seourouApps (voir hideLastSeen pour ceux-là).
  videosPrivate       Boolean             @default(false)
  // "Parametres et confidentialite" (Diarala_Tiktak) : qui peut commenter mes
  // publications "Clips" -- "everyone" (par defaut, comportement inchange),
  // "followers" (seulement mes abonnes, voir modele Follow plus bas), ou
  // "noone" (personne d'autre que moi). Verifie dans video.controller.js,
  // createComment -- je peux toujours commenter mes PROPRES publications,
  // quel que soit ce reglage.
  commentPermission   String              @default("everyone")
  // Autorise les AUTRES personnes a telecharger mes publications "Clips"
  // depuis le menu d'appui long (voir videos.html, clipOptDownload) --
  // n'empeche jamais de telecharger mes PROPRES publications. Comme
  // "Autoriser le telechargement" chez TikTok.
  allowDownloads      Boolean             @default(true)
}

// Mouvement de crédits "Solde" (voir User.creditsBalance ci-dessus) : positif
// quand j'en gagne (ex: quelqu'un aime une de mes vidéos), négatif quand j'en
// dépense (ex: "Promouvoir" une publication, voir Video.boostedUntil). Garder
// chaque mouvement (plutôt que juste le total) permet d'afficher un vrai
// historique dans l'écran "Solde", et de vérifier/corriger le total en cas de
// doute plus tard.
model CreditTransaction {
  id             String   @id @default(uuid())
  userId         String
  amount         Int
  // Courte clé technique (ex: "like_reçu", "abonné_gagné", "boost_video",
  // "bonus_bienvenue") plutôt qu'un texte libre — permet d'afficher un
  // libellé traduit/cohérent côté client sans dépendre de ce qui a été
  // stocké au moment du mouvement.
  reason         String
  // Vidéo concernée, quand applicable (ex: "like_reçu" sur telle vidéo,
  // "boost_video" de telle vidéo) — absente pour un mouvement qui ne concerne
  // pas une vidéo en particulier (ex: bonus de bienvenue). onDelete: SetNull
  // (pas Cascade) : l'historique de solde reste même si la vidéo est
  // supprimée depuis.
  relatedVideoId String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Une "vue" d'une vidéo/photo "Clips" (pour les statistiques "TikTok
// Studio") — une ligne par visionnage compté côté client (voir videos.html,
// setupObserver : comptée une seule fois par vidéo par session, pas à
// chaque repassage devant elle en scrollant). Pas de contrainte unique
// (contrairement à VideoLike) : la même personne peut générer plusieurs
// vues au fil des jours, ce qui permet de reconstituer une courbe dans le
// temps plutôt qu'un simple compteur figé.
model VideoView {
  id        String   @id @default(uuid())
  videoId   String
  viewerId  String
  createdAt DateTime @default(now())

  video  Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@index([viewerId])
}

// Un utilisateur bloqué ne peut plus envoyer de message ni appeler la personne
// qui l'a bloqué (vérifié dans les deux sens dans les gestionnaires socket).
// Un même couple (blockerId, blockedId) ne peut exister qu'une fois.
model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

// Code temporaire à 6 chiffres généré par un compte "parent" (Contrôle
// parental) pour lier le compte d'un enfant au sien — même idée que OtpCode
// (utils/otp.js) : code hashé nulle part ici volontairement (contrairement à
// OtpCode) car il n'a besoin de protéger qu'une liaison entre deux comptes
// déjà authentifiés, pas un accès non authentifié ; il expire vite (voir
// parental.controller.js) et n'est utilisable qu'une fois (consumedAt).
model ParentLinkCode {
  id         String    @id @default(uuid())
  code       String    @unique
  parentId   String
  parent     User      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
}

// Répertoire personnel de contacts (écran "Nouvelle discussion", sélecteur de
// membres d'un groupe/communauté) : comme WhatsApp, on ne voit dans sa liste
// que les personnes dont on a le numéro — importé depuis le répertoire du
// téléphone via le Contact Picker du navigateur, ou ajouté à la main (voir
// contact.controller.js). Le numéro est stocké normalisé (voir
// utils/phone.js) ; la correspondance avec un compte existant sur l'appli se
// fait par comparaison de numéro À LA LECTURE (pas de copie ici), pour qu'un
// contact apparaisse automatiquement dès qu'il crée son compte plus tard,
// sans avoir besoin de le réimporter.
model Contact {
  id        String   @id @default(uuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  phone     String   // numéro normalisé (ex: "+224621000000")
  label     String?  // nom tel qu'il apparaît dans le répertoire du téléphone, ou saisi à la main
  createdAt DateTime @default(now())

  @@unique([ownerId, phone])
  @@index([phone])
}

model Conversation {
  id        String   @id @default(uuid())
  isGroup   Boolean  @default(false)
  name      String?  // utilisé seulement pour les conversations de groupe
  createdAt DateTime @default(now())

  // Rattachement optionnel à une Communauté (onglet "Communautés") : un groupe
  // "normal" de la communauté, ou son unique groupe d'annonces (isAnnouncement),
  // où seuls les admins de la communauté peuvent écrire (vérifié dans chat.js).
  communityId    String?
  isAnnouncement Boolean @default(false)

  participants ConversationParticipant[]
  messages     Message[]
  calls        Call[]
  community    Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  // Dernière fois que cet utilisateur a ouvert/vu la conversation : sert à savoir
  // quels messages envoyés par les AUTRES participants ont été "lus" par lui
  // (affichage des doubles coches ✓✓, comme WhatsApp/iMessage).
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sourdine (Paramètres → discussion) : n'affecte que les notifications push
  // envoyées à CET utilisateur pour CETTE conversation (voir sockets/chat.js,
  // notifyNewMessage) — la conversation reste visible normalement, juste sans
  // notification. Propre à chaque participant, pas à la conversation entière.
  muted    Boolean @default(false)
  // Archivage (liste des discussions) : masque la conversation de la liste
  // principale sans la supprimer ni en retirer les autres participants — propre
  // à chaque participant, comme WhatsApp (archiver chez moi ne l'archive pas
  // chez l'autre).
  archived Boolean @default(false)
  // Verrouillage (comme "Discussions verrouillées" de WhatsApp) : masque la
  // conversation de la liste principale ET de l'archivage, visible uniquement
  // dans la sous-vue "Discussions verrouillées" après re-saisie du mot de passe
  // du compte (voir auth.controller.js, verifyPassword). Propre à chaque
  // participant, comme muted/archived.
  locked   Boolean @default(false)
  // "Effacer la discussion" → "Supprimer uniquement pour moi" (comme WhatsApp) :
  // horodatage à partir duquel je masque les messages plus anciens, seulement
  // de MON côté (l'autre participant garde les siens). Contrairement à
  // muted/archived/locked qui sont des états, celui-ci est juste une date de
  // coupure comparée à Message.createdAt (voir getMessages/serializeConversation).
  clearedAt DateTime?

  @@unique([conversationId, userId])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  content        String
  createdAt      DateTime @default(now())

  // Pièce jointe optionnelle (photo, fichier ou message vocal).
  // "type" vaut "text" (par défaut), "image", "file" ou "voice".
  // Le contenu binaire est stocké encodé en base64 directement dans la base
  // Neon (pas de service de stockage externe) : suffisant pour des fichiers
  // de quelques Mo (photos compressées, notes vocales courtes/moyennes).
  type            String  @default("text")
  attachmentData  String? // contenu du fichier encodé en base64
  attachmentMime  String? // ex: "image/jpeg", "audio/webm", "application/pdf"
  attachmentName  String? // nom du fichier d'origine
  attachmentSize  Int?    // taille en octets du fichier d'origine
  duration        Int?    // durée en secondes, pour les messages vocaux

  // Suppression "douce" : la ligne reste (pour ne pas casser l'historique/les
  // aperçus), mais le contenu et la pièce jointe sont effacés et remplacés par
  // un texte de substitution ("Message supprimé") côté client.
  deleted         Boolean @default(false)

  // Réponse citée (comme WhatsApp) : référence facultative vers le message
  // auquel celui-ci répond. onDelete: SetNull plutôt que Cascade — si le
  // message d'origine est effacé définitivement (voir message:erase), la
  // réponse elle-même doit rester, juste sans aperçu du message cité.
  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReplies")

  // Édition après envoi (comme WhatsApp) : le contenu est remplacé en place,
  // "edited" sert juste à afficher la mention "modifié" côté client. Impossible
  // sur un message avec pièce jointe ni un message déjà supprimé (voir
  // sockets/chat.js, message:edit).
  edited    Boolean   @default(false)
  editedAt  DateTime?

  // Message épinglé en haut de la discussion (comme WhatsApp, limité à
  // quelques messages à la fois, voir MAX_PINNED_PER_CONVERSATION).
  pinned    Boolean   @default(false)
  pinnedAt  DateTime?

  // Vrai si ce message est une copie transférée depuis une autre discussion
  // (voir sockets/chat.js, message:forward) : sert juste à afficher la mention
  // "Transféré" côté client, comme WhatsApp.
  forwarded Boolean   @default(false)

  reactions MessageReaction[]
  // "Supprimer pour moi seulement" (menu d'appui long) sur un message REÇU :
  // contrairement à "pour tout le monde" (réservé à l'auteur, voir
  // sockets/chat.js), n'importe quel participant peut masquer un message
  // juste de son côté, sans toucher à la ligne elle-même ni à ce que voient
  // les autres. Une ligne par (message, utilisateur qui l'a masqué).
  hiddenFor MessageHiddenForUser[]

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

model MessageHiddenForUser {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

// Réaction emoji sur un message (👍 ❤️ 😂 😮 😢 🙏, comme WhatsApp) : une seule
// réaction par utilisateur et par message (choisir un nouvel emoji remplace
// l'ancien, comme WhatsApp — pas d'accumulation de plusieurs réactions du
// même utilisateur sur le même message).
model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model Call {
  id             String    @id @default(uuid())
  conversationId String
  type           String    // "video" | "audio"
  status         String    @default("ongoing") // "ongoing" | "ended"
  startedAt      DateTime  @default(now())
  endedAt        DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  participants CallParticipant[]
}

model CallParticipant {
  id       String    @id @default(uuid())
  callId   String
  userId   String
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Abonnement du navigateur/appareil aux notifications push (Web Push standard).
// Un même utilisateur peut avoir plusieurs abonnements (un par appareil/navigateur
// où il s'est connecté et a autorisé les notifications).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Appareil connecté (Paramètres → Appareils connectés, comme WhatsApp) : une
// ligne par connexion (voir auth.controller.js register/login), révocable à
// distance (revokedAt) — vérifié à chaque requête authentifiée et à chaque
// connexion Socket.io (voir middleware/auth.js et sockets/index.js). Pas de
// session persistée côté client (le token vit seulement en mémoire, pas en
// localStorage) : un appareil correspond donc à ce qui est actif MAINTENANT,
// pas à un identifiant matériel stable dans le temps.
model Device {
  id           String    @id @default(uuid())
  userId       String
  // Ex: "Chrome sur Windows", "Safari sur iPhone" — dérivé du User-Agent à la
  // connexion, voir utils/deviceLabel.js.
  label        String
  userAgent    String?
  createdAt    DateTime  @default(now())
  // Rafraîchi à chaque requête authentifiée (voir middleware/auth.js) : permet
  // de trier la liste par activité récente, comme WhatsApp.
  lastActiveAt DateTime  @default(now())
  // Non nul dès que déconnecté (bouton "Se déconnecter" sur cet appareil, ou
  // "Se déconnecter de tous les autres appareils" depuis un autre) — on garde
  // la ligne plutôt que de la supprimer, au cas où on affiche un historique plus tard.
  revokedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Statut (onglet "Actus", comme les Statuts WhatsApp) : texte coloré ou photo,
// visible par tous les utilisateurs (pas de notion de "contacts" dans cette
// appli) pendant 24h, puis expiré (filtré côté serveur, jamais réellement
// supprimé automatiquement — plus simple qu'une tâche planifiée).
model Status {
  id              String   @id @default(uuid())
  userId          String
  type            String   // "text" | "photo"
  content         String?  // texte du statut, ou légende facultative d'une photo
  backgroundColor String?  // couleur de fond pour un statut texte (ex: "#25d366")
  attachmentData  String?  // photo encodée en base64, pour un statut photo
  attachmentMime  String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views StatusView[]
}

// Vue d'un statut par un utilisateur (pour afficher "vu par X personnes" à
// l'auteur, et distinguer les statuts déjà vus des nouveaux côté lecteur).
model StatusView {
  id       String   @id @default(uuid())
  statusId String
  viewerId String
  viewedAt DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer User   @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
}

// Communauté (onglet "Communautés", comme WhatsApp) : regroupe plusieurs
// discussions de groupe sous un même nom, avec un groupe d'annonces
// (Conversation.isAnnouncement = true) créé automatiquement, où seuls les
// admins de la communauté peuvent écrire.
model Community {
  id          String   @id @default(uuid())
  name        String
  description String?
  creatorId   String
  createdAt   DateTime @default(now())

  creator       User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members       CommunityMember[]
  conversations Conversation[]
}

model CommunityMember {
  id          String   @id @default(uuid())
  communityId String
  userId      String
  role        String   @default("member") // "admin" | "member"
  joinedAt    DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
}

// Code à usage unique envoyé par SMS (vérification de numéro à l'inscription,
// mot de passe oublié). Volontairement PAS lié à User par une relation stricte :
// pour "mot de passe oublié", le numéro doit pouvoir être validé même si on ne
// veut pas révéler si un compte existe pour ce numéro (voir auth.controller.js,
// forgotPassword). Un seul code actif à la fois par (phone, purpose) : en créer
// un nouveau invalide silencieusement les précédents (voir utils/otp.js).
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  // Jamais stocké en clair : seul son hash bcrypt est conservé, comme un mot de passe.
  codeHash   String
  purpose    String    // "verify_phone" | "reset_password"
  expiresAt  DateTime
  consumedAt DateTime?
  // Nombre de tentatives de vérification déjà faites avec ce code : au-delà de
  // OTP_MAX_ATTEMPTS (voir utils/otp.js), le code est refusé même s'il est
  // encore valide, pour limiter le brute-force sur un code à 6 chiffres.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, purpose])
}

// "Clips" — vidéo courte façon TikTok, premier produit lié depuis "Autres
// produits" (Paramètres), avec les mêmes comptes que le reste de
// l'application. Version volontairement minimale pour démarrer : fil
// chronologique + likes, pas encore de commentaires/abonnements/algorithme.
// Le fichier vidéo est stocké encodé en base64 directement dans la base,
// comme les pièces jointes de message (voir Message ci-dessus) — pratique
// pour démarrer sans infrastructure supplémentaire, mais volontairement
// limité en taille/durée (voir utils/limits.js, MAX_VIDEO_BYTES) : cette
// méthode ne tiendra pas à grande échelle et devra migrer vers un vrai
// stockage de fichiers (S3/Cloudflare R2...) si l'usage grandit.
model Video {
  id            String   @id @default(uuid())
  authorId      String
  caption       String?
  // "video" (défaut) ou "photo" — une publication "Clips" peut être une
  // vidéo courte OU une photo (comme les Stories/Reels), voir
  // video.controller.js. videoData/videoMime restent nullable pour une
  // publication de type "photo" (et inversement pour photoData/photoMime).
  type          String   @default("video")
  videoData     String?  // contenu vidéo encodé en base64 (type === "video")
  videoMime     String?  // ex: "video/webm", "video/mp4"
  photoData     String?  // contenu photo encodé en base64 (type === "photo")
  photoMime     String?  // ex: "image/jpeg", "image/png"
  thumbnailData String?  // miniature vidéo encodée en base64 (facultative, extraite côté client) — inutile pour une photo, qui sert déjà elle-même d'aperçu
  thumbnailMime String?
  duration      Int?     // durée en secondes (mesurée côté client, juste indicative) — uniquement pour une vidéo
  createdAt     DateTime @default(now())

  // Son ajouté à la publication ("Ajouter un son", comme TikTok) — deux
  // options mutuellement exclusives (voir video.controller.js, createVideo) :
  // soundId pointe vers la bibliothèque partagée (voir modèle Sound
  // ci-dessous, alimentée uniquement par un administrateur), OU
  // personalSoundData contient un son/musique personnel importé par l'auteur
  // lui-même juste pour cette publication (pas ajouté à la bibliothèque
  // partagée). Aucun des deux : la vidéo garde simplement sa propre bande son
  // d'origine (comportement inchangé, "son original").
  soundId           String?
  sound             Sound?  @relation(fields: [soundId], references: [id], onDelete: SetNull)
  personalSoundData String? // son personnel encodé en base64
  personalSoundMime String?
  personalSoundName String? // nom affiché (ex: nom du fichier importé)

  // "Promouvoir" (menu ☰) : dépense des crédits "Solde" (voir
  // User.creditsBalance/CreditTransaction ci-dessus) pour faire remonter
  // cette publication dans le fil "Pour toi" de tout le monde pendant une
  // durée limitée, comme une mise en avant payante — sauf qu'ici la
  // "monnaie" est interne à l'app plutôt qu'un vrai paiement (voir
  // video.controller.js, boostVideo). Null/passé = pas boostée.
  boostedUntil DateTime?

  // Compteur de partages (icône flèche du fil "Pour toi"/"Suivis", comme
  // TikTok — voir videos.html, recordShare) : incrémenté à chaque partage
  // RÉEL (copier le lien, WhatsApp, Telegram, Messenger, envoi à un contact),
  // pas juste à l'ouverture de la feuille "Envoyer à". Simple compteur
  // dénormalisé (pas de ligne par partage, contrairement à VideoView) : on
  // n'a pas besoin ici de courbe dans le temps, juste d'un total affiché.
  sharesCount Int @default(0)

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes    VideoLike[]
  saves    VideoSave[]
  comments VideoComment[]
  views    VideoView[]
  reports  VideoReport[]

  @@index([createdAt])
  @@index([boostedUntil])
  // Onglet "Suivis" (listVideos, branche onlyFollowing : "where.authorId = {
  // in: authorIds }", triée par createdAt) — sans index composite, Postgres
  // doit filtrer par authorId puis trier le résultat à la main plutôt que de
  // parcourir un index déjà dans le bon ordre ; ça se voit surtout une fois
  // qu'il y a beaucoup de vidéos ("rapide avec 10 vidéos, lent avec 500").
  @@index([authorId, createdAt])
}

// Diffusion en direct ("LIVE", comme TikTok, voir la demande de Lancine) :
// un utilisateur diffuse sa caméra/micro en direct, les autres la regardent
// en temps réel. La signalisation WebRTC (offres/réponses SDP, candidats ICE)
// passe entièrement par Socket.io (voir sockets/live.js) — ce modèle ne sert
// qu'à savoir QUELS directs sont en cours (pour la liste "LIVE", voir
// video.controller.js/listLiveSessions) et à en garder un historique minimal.
// Topologie "mesh" adaptée au diffuseur unique : CHAQUE spectateur établit sa
// propre connexion peer-to-peer directe avec le diffuseur (pas de connexions
// spectateur-à-spectateur, contrairement à un appel de groupe) — le nombre de
// connexions ouvertes par le diffuseur croît avec le nombre de spectateurs
// (limite raisonnable sur un plan gratuit ; au-delà, un vrai serveur média
// (SFU) deviendrait nécessaire, comme noté dans sockets/signaling.js pour les
// appels de groupe).
model LiveSession {
  id          String    @id @default(uuid())
  hostId      String
  title       String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  // Dénormalisé pour un affichage instantané dans la liste "LIVE" (nombre de
  // spectateurs ACTUELLEMENT connectés, pas un cumul) — mis à jour en direct
  // depuis sockets/live.js à chaque arrivée/départ, jamais via une requête
  // REST dédiée.
  viewerCount Int       @default(0)

  host User @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([endedAt])
}

// Son de la bibliothèque partagée "Clips" (bouton "Ajouter un son" façon
// TikTok) : volontairement alimentée UNIQUEMENT par un administrateur (voir
// requireAdmin, middleware/auth.js) plutôt qu'ouverte à tout le monde — une
// bibliothèque de musiques accessible à tous pose un vrai risque de droits
// d'auteur si elle contient des morceaux commerciaux ; à n'alimenter qu'avec
// des sons libres de droits ou créés/achetés avec une licence adaptée. Un son
// personnel importé par un utilisateur juste pour SA publication (pas ajouté
// ici) est stocké directement sur Video, voir ci-dessus.
model Sound {
  id        String   @id @default(uuid())
  name      String
  audioData String   // contenu audio encodé en base64
  audioMime String   // ex: "audio/mpeg", "audio/mp4"
  duration  Int?     // durée en secondes, indicative
  addedById String
  createdAt DateTime @default(now())

  addedBy User    @relation(fields: [addedById], references: [id], onDelete: Cascade)
  videos  Video[]

  @@index([createdAt])
}

model VideoLike {
  id        String   @id @default(uuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

// Vidéo "enregistrée" par un utilisateur (bouton marque-page façon TikTok) —
// juste un signet personnel pour l'instant, pas encore d'écran "mes vidéos
// enregistrées" dédié côté client, mais structuré comme VideoLike pour en
// ajouter un facilement plus tard.
model VideoSave {
  id        String   @id @default(uuid())
  videoId   String
  userId    String
  createdAt DateTime @default(now())

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([videoId, userId])
}

// Commentaire texte simple sur une vidéo/photo "Clips" — pas de réponses
// imbriquées ni de réactions pour l'instant (volontairement minimal, comme le
// reste de "Clips" — voir le commentaire au-dessus du modèle Video).
model VideoComment {
  id        String   @id @default(uuid())
  videoId   String
  authorId  String
  text      String
  createdAt DateTime @default(now())

  video  Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
}

// Signalement d'une vidéo/photo "Clips" (menu d'appui long sur une
// publication → "Signaler", comme TikTok) : une ligne par signalement,
// jamais supprimée ni traitée automatiquement — sert seulement à garder une
// trace consultable manuellement en base pour une future modération. Pas de
// contrainte unique contrairement à VideoLike : la même personne peut
// signaler plusieurs fois la même vidéo (ex: pour une raison différente),
// on préfère tout garder plutôt que d'en perdre.
model VideoReport {
  id         String   @id @default(uuid())
  videoId    String
  reporterId String
  // Courte clé technique choisie dans un menu fermé côté client (ex:
  // "contenu_inapproprie", "spam", "violence", "faux_compte", "autre")
  // plutôt qu'un texte libre — voir videos.html, openClipOptionsMenu.
  reason     String
  createdAt  DateTime @default(now())

  video    Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reporter User  @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
}

// Abonnement "Clips" (onglet "Ami(e)s", écran Profil) — direct comme TikTok :
// suivre quelqu'un ne nécessite pas qu'il l'accepte (contrairement à une
// demande d'ami Facebook). followerId = celui qui suit, followingId = celui
// qui est suivi.
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
}
